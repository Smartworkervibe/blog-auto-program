# 🐟 블로그 자동화 프로그램 환경 변수
# 이 파일을 .env로 복사하고 실제 값을 입력하세요!

# ============================================
# 🔑 API 키 설정
# ============================================
# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# 사용할 AI 선택 (openai 또는 gemini)
AI_PROVIDER=openai

# 네이버 개발자 센터 API (https://developers.naver.com/)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ============================================
# 👤 네이버 계정 정보
# ============================================
NAVER_ID=your-naver-id
NAVER_PASSWORD=your-naver-password
NAVER_BLOG_ID=your-blog-id

# ============================================
# 🏢 렌탈 업체 정보
# ============================================
RENTAL_COMPANY_NAME=우리렌탈
RENTAL_CONTACT=1588-0000
